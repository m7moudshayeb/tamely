{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tamely",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../fe/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // Per-visitor limits (Cloudflare rate limiting; period must be 10 or 60 seconds).
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "AI_LIMIT", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "4103", "simple": { "limit": 300, "period": 60 } }
  ],
  // The domain is attached at deploy time (`yarn deploy` → wrangler deploy --domain tamely.dev),
  // not here: a route in this file makes local dev pretend to be tamely.dev and breaks sign-in.
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "AI_FALLBACK_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  }
  // Secret (wrangler secret put SESSION_SECRET, or .dev.vars locally):
  //   SESSION_SECRET  random string, at least 32 characters
}
